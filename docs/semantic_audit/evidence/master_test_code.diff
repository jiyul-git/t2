+                                        open_bb=kw.get('open_bb') or 2.5)
+                 if ag and pos in ('BB', 'SB', 'BTN', 'CO') else None)
+        rows.append({'seed': ctx['seed'], 'h': ctx['h'], 'sit': sit, 'pos': pos,
