+def _numeric_snapshot(r):
+    """Snapshot cumulative public-observation counters at a hand boundary."""
+    return {
+        k: v for k, v in r.items()
+        if k != '_hand_hist' and isinstance(v, (int, float))
+        and not isinstance(v, bool)
