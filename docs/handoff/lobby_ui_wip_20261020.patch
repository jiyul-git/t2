diff --git a/ui/web/lobby.css b/ui/web/lobby.css
index 42b60401..abedf4db 100644
--- a/ui/web/lobby.css
+++ b/ui/web/lobby.css
@@ -401,3 +401,40 @@ html{-webkit-tap-highlight-color:transparent}
 /* 왼쪽 위 ♠ T2: 가장자리에서 반 글자쯤 띄우고, ♠ 와 T2 · 글자 사이를 조금 넓힌다. */
 .brand{margin-left:.5em;letter-spacing:.02em}
 .brand span{margin-right:.08em}
+
+/* ---------- 대회 카드의 행동 단추(참가 신청 ↔ 참가 취소 / 테이블로 / 결과 보기) ---------- */
+.card .cardFoot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px}
+.card .cardFoot .enter{display:inline;margin:0;font-size:10px;font-weight:800;color:#8a6d33}
+.cardAction{flex:0 0 auto;min-height:30px;padding:0 14px;border:0;border-radius:999px;font-size:11px;font-weight:900;
+ background:linear-gradient(90deg,#cda95f,#e1c786);color:#1b1408;box-shadow:0 1px 3px #0004}
+.cardAction.isCancel,#join.isCancel,#featuredJoin.isCancel{background:#fff8ea;color:#7a2f22;border:1px solid #c9a07a;box-shadow:none}
+.cardAction:disabled{opacity:.5}
+
+/* ---------- 상태 표시·탭: 청록 위 하늘빛 테두리 대신 금색 계열 ---------- */
+.card .tag,.featured-status{background:#f3e2b5;color:#6b4a12}
+.featured-meta{color:#e1c27c}
+.tabs button{border-color:#8a7045;background:#0b2a2f}
+
+/* ---------- 낮(lounge.js 가 html.lobby-day 를 붙인다): 밝은 모래색 바탕에 맞춘 글자·단추 ---------- */
+html.lobby-day .top{border-bottom-color:#b8975a88}
+html.lobby-day .brand,html.lobby-day .brand span{color:#6b4a12;text-shadow:none}
+html.lobby-day .header-profile{color:#6b4a12}
+html.lobby-day .section h2{color:#4a3214;text-shadow:none}
+html.lobby-day .sectionHead p{color:#6e5a3c}
+/* 그림 바로 아래 문구는 그림 바닥(어두운 라운지 바닥) 위라 낮에도 밝은 글자 그대로 둔다. */
+html.lobby-day .featured{background:#fbf3e2;border-color:#c9a55c}
+html.lobby-day .featured-top{background:linear-gradient(90deg,#f3e2b5,#fbf3e2);color:#5a4220}
+html.lobby-day .featured-meta{color:#8a6d33}
+html.lobby-day .tabs button{background:#fffaf0;border-color:#c9a55c;color:#5a4220}
+html.lobby-day .tabs button.active{background:linear-gradient(#f2d48d,#d9b062);border-color:#b8913f;color:#2a1d08}
+html.lobby-day .card{box-shadow:0 2px 6px #6b4a1226;border-color:#d9c39a}
+html.lobby-day .bottom{background:#f7efdfee;border-top-color:#c9a55c}
+html.lobby-day .bottom button{color:#8a7350}
+html.lobby-day .bottom button.active{color:#6b4a12;background:linear-gradient(180deg,#e9cf9333,#d9b06255)}
+html.lobby-day .emptyState{color:#6e5a3c;border-color:#c9a55c}
+
+/* 선 아이콘(유니코드 기호 ⌂ ♜ ▥ ⚙ ◷ 대신) */
+.ic{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.15em}
+.bottom button span .ic{width:22px;height:22px}
+.header-profile .ic{width:22px;height:22px}
+.featured-top .ic{width:15px;height:15px;margin-right:2px}
