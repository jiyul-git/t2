# Production default: Firebase Authentication
T2_AUTH_MODE=firebase
T2_FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: after the first successful login, set this to that Firebase UID
# to make the first server strictly single-user.
# T2_SINGLE_USER_UID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VPS/local service-account JSON must live OUTSIDE the git repository.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json

# Local transport testing only (never expose this mode to the internet):
# T2_AUTH_MODE=dev
# T2_ALLOW_DEV_AUTH=1
# T2_DEV_TOKEN=replace-with-at-least-24-random-characters
# T2_SINGLE_USER_UID=local-dev-user
