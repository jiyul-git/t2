+/// 169-class action frequencies at every flop decision node below `idx` (stops at chance / terminal nodes),
+/// weighted by the actor's own reach (range weight x own action probabilities on the path).
+fn export_flop_classes(s: &Solver, idx: u32, reach: [Vec<f32>; 2], key: String, out: &mut Vec<serde_json::Value>) {
+    use solver::tree::KIND_ACTION;
+    let spot = &*s.spot;
+    let node = &spot.tree.nodes[idx as usize];
+    if node.kind != KIND_ACTION {
+        return;
+    }
+    let p = node.player as usize;
+    let nh = spot.hands[p].len();
+    let na = node.num_children as usize;
+    let sigma = s.average_strategy(idx, node);
+    let mut num = vec![vec![0f64; NUM_CLASSES]; na];
+    let mut den = vec![0f64; NUM_CLASSES];
+    for (i, h) in spot.hands[p].iter().enumerate() {
+        let k = cls(h);
+        let r = reach[p][i] as f64;
+        den[k] += r;
+        for a in 0..na {
+            num[a][k] += r * sigma[a * nh + i] as f64;
+        }
+    }
+    let acts: Vec<serde_json::Value> = (0..na).map(|a| serde_json::to_value(spot.tree.actions[node.actions_start as usize + a]).unwrap()).collect();
+    let freq: Vec<Vec<Option<f64>>> = (0..na).map(|a| (0..NUM_CLASSES).map(|k| if den[k] > 1e-12 { Some(num[a][k] / den[k]) } else { None }).collect()).collect();
+    out.push(serde_json::json!({"key": key, "actor": p, "pot": node.put[0] + node.put[1], "put": node.put, "actions": acts,
+        "class_freq": freq, "class_reach": den}));
+    for a in 0..na {
+        let mut r2 = reach.clone();
+        for i in 0..nh {
+            r2[p][i] = reach[p][i] * sigma[a * nh + i];
+        }
+        let child = spot.tree.children[node.children_start as usize + a];
+        let k2 = if key.is_empty() { format!("a{a}") } else { format!("{key},a{a}") };
+        export_flop_classes(s, child, r2, k2, out);
+    }
+}
