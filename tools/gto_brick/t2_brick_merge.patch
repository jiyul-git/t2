@@ -0,0 +1,300 @@
+//! T2 brick merge (opt-in, T2_BRICK_MERGE=1 in t2_cont_panel; off by default = bit-identical solver).
+//!
+//! At a turn / river chance node, "brick" cards (rule `brick_v1` below, fixed in code before any comparison
+//! run) are merged into ONE representative branch: only the representative's subtree is solved, and every
+//! other brick card c of the group (same suit as rep) reuses it through the RANK SWAP sigma = (rank(rep) rank(c)),
+//! applied to every suit (2c-board 22 <-> 3c-board 33, A2s <-> A3s; coordinator 10-31):
+//!     value of hand h in the c-branch := value of sigma(h) in the rep-branch,
+//! i.e. the same action tree and (sigma-mapped) strategy, each merged card keeping its own 1/45 (1/44) chance
+//! weight, so the representative effectively counts as many times as the group has cards. sigma fixes the board
+//! (neither rank is on it) and maps {board, c, h} onto {board, rep, sigma(h)}: sets stay sets, pairs stay pairs.
+//! What is approximated: (1) the range weights of h vs sigma(h) differ (22 vs 33 in each range) -> rule 5 bounds
+//! it; (2) the order of the two ranks relative to the hand's other cards (kickers, straights) -> rules 2 and 4.
+//!
+//! Rule brick_v1 (board B = cards on the board before the dealt card x; B has 3 cards at the turn, 4 at the river):
+//!   1. rank(x) is not a rank of B                                   (no paired board)
+//!   2. rank(x) < second-highest card of B (sorted with duplicates)  (no new overcard / second card)
+//!   3. turn: suit(x) does not occur on B (no new flush draw, no completed flush; a rainbow flop's 4th suit only)
+//!      river: suit(x) occurs at most once on B (after x at most 2 of that suit: no flush possible in it)
+//!   4. straights, per player p, weighted by p's root range weights over the combos not blocked by B and x:
+//!      share of combos for which x completes a straight, or (turn only) x creates a new one-card straight out
+//!      (some river rank y makes a straight with x that it would not make without x) <= DRAW_SHARE_MAX.
+//!   5. merge with the group representative b only if, for both players, the rank-swap weight mismatch
+//!      sum_h |w(h) - w(sigma h)| / 2 over combos holding rank(x) or rank(b) (not blocked by B, x, b), divided by the
+//!      range weight, <= SWAP_MISMATCH_MAX; otherwise x keeps its exact branch.
+//! Groups: per suit, among the suit-isomorphism representatives of the node; representative = median card;
+//! merging needs >= 2 cards in the group. Recorded per context: per brick card the share of each range holding its rank
+//! (pocket pair -> set, one card -> pair), and per merged card its representative and mismatch.
+use crate::cards::{card_to_string, make_card, rank, suit, Card};
+use crate::game::{Dealt, Spot};
+use crate::tree::SENTINEL;
+
+pub const RULE: &str = "brick_v1";
+/// Rule 4 threshold, fixed before any comparison: at most 2% of either player's range (combo weight).
+pub const DRAW_SHARE_MAX: f64 = 0.02;
+/// Rule 5 threshold, fixed before any comparison: 1% of either range. Reason: a mismatched combo is a set/pair hand
+/// valued at the wrong weight; set vs no set is worth up to ~one pot+ (here ~10 bb at 100 bb deep), so 1% bounds the
+/// per-branch error at about 0.1 bb, below the precision panel error U(144) ~ 0.15 bb of p100 CO.
+pub const SWAP_MISMATCH_MAX: f64 = 0.01;
+
+pub struct BrickMap {
+    /// idx[p][a*52+b] = index in spot.hands[p] of the combo {a,b} (both orders), SENTINEL if absent.
+    pub idx: [Vec<u32>; 2],
+    /// merge plan (src[c] = representative, 255 = exact) for the card dealt right after the root board.
+    pub first: Option<[u8; 52]>,
+    /// root = flop: merge plan for the river after turn card t (index t); empty otherwise.
+    pub second: Vec<Option<[u8; 52]>>,
+    root_len: usize,
+    /// per context: (board string, brick cards, max share of rule 4 per player) for the record
+    pub log: Vec<serde_json::Value>,
+}
+
+fn rank_bits(cards: impl Iterator<Item = u8>) -> u16 {
+    // bit 0 = ace low, bit r+1 = rank r
+    let mut m = 0u16;
+    for r in cards {
+        m |= 1 << (r + 1);
+        if r == 12 {
+            m |= 1;
+        }
+    }
+    m
+}
+
+fn straight(m: u16) -> bool {
+    (0..=9).any(|lo| (m >> lo) & 0x1f == 0x1f)
+}
+
+fn rb(r: u8) -> u16 {
+    rank_bits(std::iter::once(r))
+}
+
+/// Rule brick_v1 for card x on board `b` (3 or 4 cards). Returns (brick, reason, max rule-4 share over players).
+pub fn classify(spot: &Spot, b: &[Card], x: Card) -> (bool, &'static str, f64) {
+    let river = b.len() == 4;
+    if b.iter().any(|&c| rank(c) == rank(x)) {
+        return (false, "pair", 0.0);
+    }
+    let mut rs: Vec<u8> = b.iter().map(|&c| rank(c)).collect();
+    rs.sort_unstable_by(|a, c| c.cmp(a));
+    if rank(x) >= rs[1] {
+        return (false, "high", 0.0);
+    }
+    let ns = b.iter().filter(|&&c| suit(c) == suit(x)).count();
+    if (!river && ns > 0) || (river && ns > 1) {
+        return (false, "suit", 0.0);
+    }
+    let bm = rank_bits(b.iter().map(|&c| rank(c)));
+    let xm = rb(rank(x));
+    let dead: u64 = b.iter().fold(1u64 << x, |m, &c| m | 1u64 << c);
+    let mut worst = 0f64;
+    for p in 0..2 {
+        let (mut tot, mut hit) = (0f64, 0f64);
+        for (i, h) in spot.hands[p].iter().enumerate() {
+            if h.mask & dead != 0 {
+                continue;
+            }
+            let w = spot.weights[p][i] as f64;
+            tot += w;
+            let hm = bm | rb(rank(h.c1)) | rb(rank(h.c2));
+            let completes = straight(hm | xm) && !straight(hm);
+            let new_out = !river && (0..13u8).any(|y| straight(hm | xm | rb(y)) && !straight(hm | rb(y)));
+            if completes || new_out {
+                hit += w;
+            }
+        }
+        let share = if tot > 0.0 { hit / tot } else { 0.0 };
+        worst = worst.max(share);
+    }
+    if worst > draw_max() {
+        return (false, "straight", worst);
+    }
+    (true, "brick", worst)
+}
+
+/// thresholds in force: the constants above unless overridden for a sensitivity count (T2_BRICK_DRAW_MAX /
+/// T2_BRICK_SWAP_MAX; t2_cont_panel records the values in force in the provenance key).
+pub fn draw_max() -> f64 {
+    std::env::var("T2_BRICK_DRAW_MAX").ok().and_then(|v| v.parse().ok()).unwrap_or(DRAW_SHARE_MAX)
+}
+pub fn swap_max() -> f64 {
+    std::env::var("T2_BRICK_SWAP_MAX").ok().and_then(|v| v.parse().ok()).unwrap_or(SWAP_MISMATCH_MAX)
+}
+
+fn swap_rank(c: u8, ra: u8, rb: u8) -> u8 {
+    let r = rank(c);
+    if r == ra { make_card(rb, suit(c)) } else if r == rb { make_card(ra, suit(c)) } else { c }
+}
+
+/// share of p's range (weights, combos not blocked by `dead`) holding rank r: (pocket pair, exactly one card)
+fn hold_share(spot: &Spot, p: usize, dead: u64, r: u8) -> (f64, f64) {
+    let (mut tot, mut pp, mut one) = (0f64, 0f64, 0f64);
+    for (i, h) in spot.hands[p].iter().enumerate() {
+        if h.mask & dead != 0 {
+            continue;
+        }
+        let w = spot.weights[p][i] as f64;
+        tot += w;
+        let n = (rank(h.c1) == r) as u8 + (rank(h.c2) == r) as u8;
+        if n == 2 { pp += w } else if n == 1 { one += w }
+    }
+    if tot > 0.0 { (pp / tot, one / tot) } else { (0.0, 0.0) }
+}
+
+impl BrickMap {
+    /// rule 5 mismatch for merging x into representative b (both dealt-candidates, so both dead), per player
+    fn mismatch(&self, spot: &Spot, p: usize, b_: &[Card], x: Card, b: Card) -> f64 {
+        let dead: u64 = b_.iter().fold((1u64 << x) | (1u64 << b), |m, &c| m | 1u64 << c);
+        let (ra, rb) = (rank(x), rank(b));
+        let (mut tot, mut d) = (0f64, 0f64);
+        for (i, h) in spot.hands[p].iter().enumerate() {
+            if h.mask & dead != 0 {
+                continue;
+            }
+            let w = spot.weights[p][i] as f64;
+            tot += w;
+            let r1 = rank(h.c1); let r2 = rank(h.c2);
+            if r1 == ra || r1 == rb || r2 == ra || r2 == rb {
+                let j = self.idx[p][swap_rank(h.c1, ra, rb) as usize * 52 + swap_rank(h.c2, ra, rb) as usize];
+                let wj = if j == SENTINEL { 0.0 } else { spot.weights[p][j as usize] as f64 };
+                d += (w - wj).abs();
+            }
+        }
+        if tot > 0.0 { d / 2.0 / tot } else { 0.0 }
+    }
+
+    /// Build after the root range weights are final (rule 4 reads spot.weights).
+    pub fn new(spot: &Spot) -> BrickMap {
+        let mut idx = [vec![SENTINEL; 52 * 52], vec![SENTINEL; 52 * 52]];
+        for p in 0..2 {
+            for (i, h) in spot.hands[p].iter().enumerate() {
+                idx[p][h.c1 as usize * 52 + h.c2 as usize] = i as u32;
+                idx[p][h.c2 as usize * 52 + h.c1 as usize] = i as u32;
+            }
+        }
+        let mut bm = BrickMap { idx, first: None, second: Vec::new(), root_len: spot.board.len(), log: Vec::new() };
+        let ctx = |bm: &mut BrickMap, b: &[Card], dealt: Dealt| -> Option<[u8; 52]> {
+            let mut bricks = Vec::new();
+            let mut why = serde_json::Map::new();
+            let mut avail = 0;
+            let mut info = serde_json::Map::new();
+            let dead_b: u64 = b.iter().fold(0u64, |m, &c| m | 1u64 << c);
+            for x in 0..52u8 {
+                if b.contains(&x) {
+                    continue;
+                }
+                avail += 1;
+                let (ok, reason, share) = classify(spot, b, x);
+                if ok {
+                    bricks.push(x);
+                    let hs: Vec<serde_json::Value> = (0..2).map(|p| {
+                        let (pp, one) = hold_share(spot, p, dead_b | 1u64 << x, rank(x));
+                        serde_json::json!({"set_share": (pp * 1e5).round() / 1e5, "pair_share": (one * 1e5).round() / 1e5})
+                    }).collect();
+                    info.insert(card_to_string(x), serde_json::json!({"straight_share": (share * 1e4).round() / 1e4, "hold": hs}));
+                } else {
+                    let n = why.get(reason).and_then(|v| v.as_u64()).unwrap_or(0) + 1;
+                    why.insert(reason.into(), serde_json::json!(n));
+                }
+            }
+            // suit-isomorphism representatives exactly as cfr::chance_node computes them
+            let valid = spot.perms_fixing(&dealt);
+            let is_rep = |c: u8| valid.iter().all(|&k| crate::cards::permute_card(c, &spot.suit_perms[k]) >= c);
+            let mut src = [255u8; 52];
+            let mut any = false;
+            for su in 0..4u8 {
+                let group: Vec<u8> = bricks.iter().copied().filter(|&c| suit(c) == su && is_rep(c)).collect();
+                if group.len() < 2 {
+                    continue;
+                }
+                let rep = Self::pick_rep(&group);
+                for &c in &group {
+                    if c == rep {
+                        continue;
+                    }
+                    let mm = [bm.mismatch(spot, 0, b, c, rep), bm.mismatch(spot, 1, b, c, rep)];
+                    let ok = mm[0] <= swap_max() && mm[1] <= swap_max();
+                    if ok {
+                        src[c as usize] = rep;
+                        any = true;
+                    }
+                    if let Some(e) = info.get_mut(&card_to_string(c)) {
+                        e["rep"] = serde_json::json!(card_to_string(rep));
+                        e["swap_mismatch"] = serde_json::json!([(mm[0] * 1e5).round() / 1e5, (mm[1] * 1e5).round() / 1e5]);
+                        e["merged"] = serde_json::json!(ok);
+                    }
+                }
+                if let Some(e) = info.get_mut(&card_to_string(rep)) {
+                    e["representative"] = serde_json::json!(true);
+                }
+            }
+            let merged = src.iter().filter(|&&x| x != 255).count();
+            let bs: String = b.iter().map(|&c| card_to_string(c)).collect();
+            bm.log.push(serde_json::json!({"board": bs, "available": avail, "bricks": info, "merged_iso_reps": merged,
+                "rejected": why, "hold_note": "hold[p] = share of player p (0 = OOP, 1 = IP) range holding this rank: set_share pocket pair, pair_share one card"}));
+            if any { Some(src) } else { None }
+        };
+        let root_len = spot.board.len();
+        if root_len < 5 {
+            let f = ctx(&mut bm, &spot.board, Dealt::default());
+            bm.first = f;
+        }
+        if root_len == 3 {
+            bm.second = vec![None; 52];
+            for t in 0..52u8 {
+                if spot.board.contains(&t) {
+                    continue;
+                }
+                let mut b = spot.board.clone();
+                b.push(t);
+                let f = ctx(&mut bm, &b, Dealt::default().push(t));
+                bm.second[t as usize] = f;
+            }
+        }
+        let _ = root_len;
+        bm
+    }
+
+    /// Merge plan for the next card dealt after `dealt` (src[c] = representative, 255 = exact).
+    fn plan_for(&self, dealt: &Dealt) -> Option<[u8; 52]> {
+        match (self.root_len, dealt.len) {
+            (3, 0) | (4, 0) => self.first,
+            (3, 1) => self.second[dealt.cards[0] as usize],
+            _ => None,
+        }
+    }
+
+    /// Representative of a group (sorted card ids): the median card.
+    pub fn pick_rep(group: &[u8]) -> u8 {
+        group[group.len() / 2]
+    }
+
+    /// Index of sigma(h) in hands[p], sigma = rank swap (rank(a) rank(b)) on every suit.
+    #[inline]
+    pub fn tau_index(&self, p: usize, c1: u8, c2: u8, a: u8, b: u8) -> u32 {
+        let (ra, rb) = (rank(a), rank(b));
+        self.idx[p][swap_rank(c1, ra, rb) as usize * 52 + swap_rank(c2, ra, rb) as usize]
+    }
+
+    /// The card map of sigma (for nested chance nodes).
+    #[inline]
+    pub fn tau_card(&self, c: u8, a: u8, b: u8) -> u8 {
+        swap_rank(c, rank(a), rank(b))
+    }
+
+    /// Merge plan at a chance node, restricted to the node's traversed suit-isomorphism representatives
+    /// (`reps`, as chance_node computes them); a card or representative outside `reps` stays exact.
+    pub fn plan(&self, dealt: &Dealt, reps: &[u8]) -> Option<[u8; 52]> {
+        let mut src = self.plan_for(dealt)?;
+        let mut isr = [false; 52];
+        for &c in reps {
+            isr[c as usize] = true;
+        }
+        for c in 0..52 {
+            if src[c] != 255 && (!isr[c] || !isr[src[c] as usize]) {
+                src[c] = 255;
+            }
+        }
+        if src.iter().all(|&x| x == 255) { None } else { Some(src) }
+    }
+}
